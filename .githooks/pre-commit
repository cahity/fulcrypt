#!/usr/bin/env bash
# Pre-commit checks. Only reports problems; never modifies files.
# Enable once per clone:  git config core.hooksPath .githooks
# Skip in an emergency:   git commit --no-verify

cd "$(git rev-parse --show-toplevel)" || exit 1

failed=()

run() {
    local name="$1"
    shift
    echo "── $name"
    if ! "$@"; then
        failed+=("$name")
    fi
}

run "format (ruff format --check)" uv run ruff format --check .
run "lint (ruff check)" uv run ruff check .
run "types (mypy)" uv run mypy
run "tests (pytest)" uv run pytest -q

if ((${#failed[@]})); then
    echo
    echo "Commit blocked. Failed: ${failed[*]}"
    echo "Fix formatting/lint with:  uv run ruff format . && uv run ruff check --fix ."
    exit 1
fi

echo "All checks passed."
